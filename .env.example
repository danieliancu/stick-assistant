# Copy to backend/.env and fill in real values. Never commit backend/.env.

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-luna
# Optional: none | low | medium | high (reasoning models only; "off" disables the parameter)
OPENAI_REASONING_EFFORT=low

# Voice (Stage 2)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# marin (default) or cedar
OPENAI_TTS_VOICE=marin
# Optional: max recording length (s), reply audio lifetime (s), WAV output rate (Hz)
# VOICE_MAX_SECONDS=12
# VOICE_AUDIO_TTL_SECONDS=3600
# VOICE_OUTPUT_SAMPLE_RATE=24000

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Add your PC's LAN IP when testing with the M5StickS3, e.g. 192.168.1.50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Static token the device sends as "Authorization: Bearer <token>"
DEVICE_API_TOKEN=change-me-to-a-long-random-token
